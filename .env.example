
DATABASE_URL=

# ------------------------------------------------- Razorpay (TEST MODE ONLY) --
# From the Razorpay Dashboard in Test Mode: Settings -> API Keys.
# The key id is public and is sent to the browser to open Checkout.
# The secret is server-side only and must never reach the client.
#
# RECOVER refuses to start unless RAZORPAY_KEY_ID begins with rzp_test_.
# Leave these blank to use the built-in simulator instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Settings -> Webhooks -> the secret you chose when creating the webhook.
# Required for signature verification on live Razorpay deliveries.
# Subscribe the endpoint to: payment.captured, payment.failed, order.paid
# Endpoint: https://<your-public-host>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Anthropic --
# Enables the LLM diagnosis path. Without it, RECOVER uses the documented
# deterministic fallback in apps/api/recover/agent/fallback.py and labels every
# decision "Deterministic fallback" in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=45

# --------------------------------------------------------------------- App --
PUBLIC_WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
DEMO_SEED=20260901

# ---------------------------------------------------------------- Frontend --
# Read by Next.js at build and run time. Public by design - no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
